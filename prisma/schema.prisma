// backend/prisma/schema.prisma

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["sigva"]
}

// ─── Usuarios ─────────────────────────────────────────────────────────────────
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  phone     String?
  password  String
  role      Role     @default(DRIVER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // Placas guardadas del conductor (máximo 5) para no escribirlas en cada sesión
  savedPlates String[] @default([])

  tickets   ParkingTicket[]
  passwordResets PasswordReset[]

  @@map("users")
  @@schema("sigva")
}

enum Role {
  DRIVER
  OPERATOR
  ADMIN

  @@schema("sigva")
}

// ─── Zonas de estacionamiento ─────────────────────────────────────────────────
model ParkingZone {
  id             String   @id @default(cuid())
  name           String
  address        String
  latitude       Float
  longitude      Float
  totalSpots     Int
  ratePerHour    Float    @default(15.0)
  currency       String   @default("MXN")
  openTime       String   @default("08:00")
  closeTime      String   @default("22:00")
  isActive       Boolean  @default(true)
  radiusM        Int      @default(100) // radio (m) alrededor de la zona donde el GPS del teléfono se acepta
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  spots       ParkingSpot[]
  qrCodes     ZoneQr[]
  infractions Infraction[]

  @@map("parking_zones")
  @@schema("sigva")
}

// ─── QR de zona (1 o máximo 2 por zona) ───────────────────────────────────────
// Sticker/señal en la calle cuyo único fin es DESCARGAR la app. Apunta a
// {API}/descargar?zona={code}; la sesión de estacionamiento NO escanea QR:
// la zona se determina por el GPS del teléfono.
model ZoneQr {
  id        String   @id @default(cuid())
  code      String   @unique // e.g. "MTY01A"
  zoneId    String
  label     String?  // e.g. "Esquina norte"
  latitude  Float?   // dónde quedó instalado (informativo)
  longitude Float?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  zone ParkingZone @relation(fields: [zoneId], references: [id])

  @@map("zone_qr_codes")
  @@schema("sigva")
}

// ─── Cajones individuales ─────────────────────────────────────────────────────
model ParkingSpot {
  id        String     @id @default(cuid())
  zoneId    String
  number    String     // e.g. "A-01"
  status    SpotStatus @default(FREE)
  type      SpotType   @default(STANDARD)
  latitude  Float?
  longitude Float?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  zone        ParkingZone     @relation(fields: [zoneId], references: [id])
  tickets     ParkingTicket[]
  infractions Infraction[]

  @@unique([zoneId, number])
  @@map("parking_spots")
  @@schema("sigva")
}

enum SpotStatus {
  FREE
  OCCUPIED
  RESERVED
  DISABLED

  @@schema("sigva")
}

enum SpotType {
  STANDARD
  DISABLED
  ELECTRIC

  @@schema("sigva")
}

// ─── Tickets de estacionamiento ───────────────────────────────────────────────
model ParkingTicket {
  id              String         @id @default(cuid())
  userId          String
  spotId          String
  licensePlate    String
  status          TicketStatus   @default(ACTIVE)
  entryTime       DateTime       @default(now())
  exitTime        DateTime?
  durationMinutes Int?
  amountDue       Float?
  amountPaid      Float?
  paymentMethod   PaymentMethod?
  qrCode          String?        @unique
  // Sesión con tiempo elegido (F4): minutos contratados y hora de vencimiento
  plannedMinutes  Int?
  scheduledEnd    DateTime?
  // Ubicación del teléfono al iniciar la sesión (validación GPS por zona)
  gpsLat          Float?
  gpsLng          Float?
  gpsAccuracy     Float?
  gpsDistanceM    Float?
  // true si el sistema la cerró solo por tiempo vencido (AUTO_RELEASE_MINUTES)
  autoReleased    Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user     User        @relation(fields: [userId], references: [id])
  spot     ParkingSpot @relation(fields: [spotId], references: [id])
  payments Payment[]

  @@map("parking_tickets")
  @@schema("sigva")
}

enum TicketStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  PENDING_PAYMENT // esperando la confirmación de Mercado Pago (el cajón queda apartado)

  @@schema("sigva")
}

enum PaymentMethod {
  CARD
  CASH
  WALLET
  QR

  @@schema("sigva")
}

// ─── Infracciones (las registra el inspector desde el dashboard SIGVA) ────────
model Infraction {
  id           String           @id @default(cuid())
  number       Int              @unique @default(autoincrement()) // folio INF-000001
  licensePlate String
  type         InfractionType   @default(SIN_PAGO)
  status       InfractionStatus @default(PENDIENTE)
  amount       Float?           // monto de la multa (INFRACCION_MONTO en Railway)
  notes        String?
  spotId       String?
  zoneId       String?
  ticketId     String?          // ticket vencido relacionado, si lo hay
  issuedBy     String?          // quién la registró (p. ej. "dashboard")
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  spot ParkingSpot? @relation(fields: [spotId], references: [id])
  zone ParkingZone? @relation(fields: [zoneId], references: [id])

  @@index([licensePlate])
  @@index([createdAt])
  @@map("infractions")
  @@schema("sigva")
}

enum InfractionType {
  SIN_PAGO
  TIEMPO_VENCIDO
  OTRA

  @@schema("sigva")
}

enum InfractionStatus {
  PENDIENTE
  PAGADA
  CANCELADA

  @@schema("sigva")
}

// ─── Recuperación de contraseña por código enviado al correo ─────────────────
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String    // el código nunca se guarda en claro
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("password_resets")
  @@schema("sigva")
}

// ─── Pagos (Mercado Pago) ─────────────────────────────────────────────────────
// Un pago por inicio de sesión o por cada extensión de tiempo.
model Payment {
  id                String    @id @default(cuid())   // se manda a Mercado Pago como external_reference
  ticketId          String
  kind              String    // INICIO | EXTENSION
  minutes           Int
  amount            Float
  currency          String    @default("MXN")
  provider          String    // mercadopago | simulado
  status            String    @default("PENDIENTE") // PENDIENTE | APROBADO | RECHAZADO | EXPIRADO | REEMBOLSADO
  preferenceId      String?
  checkoutUrl       String?
  providerPaymentId String?   @unique
  providerStatus    String?
  approvedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  ticket ParkingTicket @relation(fields: [ticketId], references: [id])

  @@index([ticketId])
  @@map("payments")
  @@schema("sigva")
}
