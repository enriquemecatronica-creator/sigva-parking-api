# ─── Base de datos (Railway PostgreSQL — mismo Postgres que SIGVA) ────────────
# Copia exactamente el DATABASE_URL del servicio sigva-backend en Railway
# El parking usa schema "sigva" aislado — NO toca las tablas del SIGVA público
DATABASE_URL="postgresql://postgres:PASSWORD@HOST.railway.internal:5432/railway"

# ─── JWT — genera dos secretos distintos con: openssl rand -hex 32 ────────────
JWT_SECRET="genera_un_secreto_de_al_menos_32_caracteres_aqui"
JWT_REFRESH_SECRET="otro_secreto_diferente_para_refresh_tokens_aqui"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── Servidor ─────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ─── CORS — pon la URL de tu dashboard SIGVA en Railway ──────────────────────
# Ejemplo: https://sigva-backend-production-xxxx.up.railway.app
ALLOWED_ORIGINS="https://TU-SIGVA-URL.up.railway.app"

# ─── Admin API — para el módulo Parquímetro del dashboard SIGVA ──────────────
# Genera con: openssl rand -hex 32
# Pega el mismo valor en dashboard.html → window.PARKING_ADMIN_KEY
ADMIN_API_KEY="genera_un_token_seguro_de_32_caracteres_aqui"
